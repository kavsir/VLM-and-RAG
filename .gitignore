# Byte-compiled / optimized / Pydantic / Cython files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments and virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checking & linting caches
.mypy_cache/
.ruff_cache/

# Environment variables & local configuration
.env
.env.*
!.env.example

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db

# Data directories (commit manifests and small fixtures, not downloaded source artifacts)
data/*
!data/golden/
!data/manifests/
!data/golden/**/
!data/golden/**/.gitkeep
!data/manifests/**
data/golden/**/*.pdf
data/golden/**/*.part
