# Auto-normalize line endings to LF across Linux and Windows
* text=auto eol=lf

# Python source files
*.py text eol=lf
*.pyi text eol=lf

# Configuration and metadata files
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.whl binary
