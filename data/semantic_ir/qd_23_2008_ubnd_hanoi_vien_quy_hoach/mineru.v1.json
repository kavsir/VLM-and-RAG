    },
    {
      "id": "statement-00000008",
      "structural_node_id": "node-000000",
      "structural_canonical_path": "document",
      "text": "QUYÉT ĐNH:",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0000_b0008",
