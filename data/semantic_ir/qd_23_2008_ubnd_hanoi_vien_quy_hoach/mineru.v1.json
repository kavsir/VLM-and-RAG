          "char_end": 71
        }
      ],
      "mention_ids": [],
      "provenance": "rule_based_text"
    },
    {
      "id": "statement-00000024",
      "structural_node_id": "node-000012",
      "structural_canonical_path": "generic:3/generic:a",
      "text": "Vin Quy hoch xây dng Hà Ni có Vin trưng và các Phó Vin trung.",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0002_b0006",
          "page_index": 2,
          "char_start": 0,
          "char_end": 61
        }
      ],
      "mention_ids": [],
      "provenance": "rule_based_text"
    },
    {
      "id": "statement-00000025",
      "structural_node_id": "node-000012",
      "structural_canonical_path": "generic:3/generic:a",
      "text": "Vin trưng là ngưi đúng đâu Vin, chu trách nhim trưc UBND thành ph, Chů tch UBND thành ph và truc pháp lut trong thc hin chc năng, nhim v, quyn hn ca Vin.",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0002_b0007",
          "page_index": 2,
          "char_start": 0,
          "char_end": 153
        }
      ],
      "mention_ids": [
        "mention-00000016",
        "mention-00000017"
      ],
      "provenance": "rule_based_text"
    },
    {
      "id": "statement-00000026",
      "structural_node_id": "node-000012",
      "structural_canonical_path": "generic:3/generic:a",
      "text": "Phó Vin trưng là ngưi giúp Vin trưng ph trách mt hoc mt s līnh vưc công tác và chu trách nhim trưc Vin trung, UBND thành ph và trưc pháp lut v nhim v đưc phan công theo quy đnh ca Nhà nuc.",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0002_b0008",
          "page_index": 2,
          "char_start": 0,
          "char_end": 188
        }
      ],
      "mention_ids": [
        "mention-00000018"
      ],
      "provenance": "rule_based_text"
    },
    {
      "id": "statement-00000027",
      "structural_node_id": "node-000012",
      "structural_canonical_path": "generic:3/generic:a",
      "text": "Vic b nhim Vin trưng, Phó Vin trưng Vin Quy hoch xây dmg Hà Ni do Chú tch UBND thành ph quyt đnh theo tiêu chun chuyên môn, nghip v do B Xây dng ban hành và theo quy đnh ca pháp lut.",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0002_b0009",
          "page_index": 2,
          "char_start": 0,
          "char_end": 182
        }
      ],
      "mention_ids": [
        "mention-00000019"
      ],
      "provenance": "rule_based_text"
    },
    {
      "id": "statement-00000028",
      "structural_node_id": "node-000012",
      "structural_canonical_path": "generic:3/generic:a",
      "text": "Vic min nhim, luân chuyn, cách chc, khen thưng, ký lut và thc hin các ch đ chính sách đi vi Vin trưng, Phó Vin trưng Vin Quy hoch xay dmg Hà Ni thc hin theo quy đnh ca pháp lut.",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0002_b0010",
          "page_index": 2,
          "char_start": 0,
          "char_end": 177
        }
      ],
      "mention_ids": [],
      "provenance": "rule_based_text"
    },
