    {
      "id": "statement-00000005",
      "structural_node_id": "node-000000",
      "structural_canonical_path": "document",
      "text": "Căn c Ngh quyt s 15/2008/QH12 ngày 29 tháng 5 năm 2008 ca Quc hi v điu chinh đa gii hành chính thành ph Hà Ni và mt s tinh có liên quan;",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0000_b0005",
