    },
    {
      "id": "statement-00000007",
      "structural_node_id": "node-000000",
      "structural_canonical_path": "document",
      "text": "Xét đ ngh ca Giám đc S Ni v ti Tò trình s 236/TTr-SNV ngày 24 tháng 9 năm 2008,",
      "evidence_anchors": [
        {
          "anchor_type": "text",
