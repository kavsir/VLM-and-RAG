    },
    {
      "id": "statement-00000006",
      "structural_node_id": "node-000000",
      "structural_canonical_path": "document",
      "text": "Thc hin Thông báo s 11 TB/TU ngày 28 tháng 8 năm 2008 ca Thành úy Hà Ni v vic thành lp Vin Quy hoch xây dng Hà Ni trc thuc UBND thành ph Hà Ni;",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0000_b0006",
