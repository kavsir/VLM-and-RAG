    },
    {
      "id": "statement-00000009",
      "structural_node_id": "node-000000",
      "structural_canonical_path": "document",
      "text": "Điu 1. Thành lp Vin Quy hoch xay dng Hà Ni trc thuc UBND thành ph Hà Ni trên cơ s Vin Quy hoch xay dng Hà Ni trc thuc S Quy hoch - Kin trúc thành ph Hà Ni.",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0000_b0009",
          "page_index": 0,
          "char_start": 0,
          "char_end": 155
        }
      ],
      "mention_ids": [
        "mention-00000010"
      ],
      "provenance": "rule_based_text"
    },
    {
      "id": "statement-00000010",
      "structural_node_id": "node-000000",
      "structural_canonical_path": "document",
      "text": "Điu 2. Tên gi, v trí, chc năng, nhim v, quyn hn và cơ cu t chc ca Vin Quy hoch xay dng Hà Ni",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0000_b0010",
          "page_index": 0,
          "char_start": 0,
          "char_end": 92
        }
      ],
      "mention_ids": [],
      "provenance": "rule_based_text"
    },
    {
      "id": "statement-00000011",
      "structural_node_id": "node-000000",
      "structural_canonical_path": "document",
      "text": "1. Tên goi, v trí, chc năng",
      "evidence_anchors": [
        {
          "anchor_type": "text",
          "block_id": "qd-23-2008-ubnd-hanoi-vien-quy-hoach_v1_p0000_b0011",
