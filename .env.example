# Environment Configuration for VLM-and-RAG
# All application settings use the prefix VLM_RAG_

VLM_RAG_APP_NAME=vlm-rag
VLM_RAG_ENVIRONMENT=development
VLM_RAG_DEBUG=false
VLM_RAG_LOG_LEVEL=INFO

# OpenAI-compatible /chat/completions. Set these only for explicit --live runs.
# The API key remains local; never commit .env or paste keys into reports.
VLM_RAG_MODEL_BASE_URL=https://your-provider.example/v1
VLM_RAG_MODEL_API_KEY=
VLM_RAG_MODEL_VLM=your-vision-model
VLM_RAG_MODEL_ANSWER=your-answer-model
VLM_RAG_MODEL_TIMEOUT_SECONDS=60
VLM_RAG_MODEL_MAX_OUTPUT_TOKENS=2048
# Some providers require max_completion_tokens instead of max_tokens.
VLM_RAG_MODEL_TOKEN_PARAMETER=max_tokens
# Zero disables all model calls. This is a per-process request cap, not a dollar budget.
VLM_RAG_MODEL_MAX_REQUESTS=0
